# Copy this file to `src/web/.env` and fill in values from Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Lock client login to Papa's Google email (must match firestore.rules)
VITE_ALLOWED_EMAIL=

# Optional: custom Web Push certificate (Firebase Console > Project Settings > Cloud Messaging).
# Leave empty to use Firebase's default VAPID key.
VITE_FIREBASE_VAPID_KEY=
